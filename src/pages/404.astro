---
import Notebook from '../layouts/Notebook.astro';
import Ball from '../components/doodle/Ball.astro';
---

<Notebook title="Offside" description="This page does not exist." noindex>
  <section class="lost">
    <svg viewBox="-20 -20 40 40" width="96" height="96" aria-hidden="true">
      <Ball still />
    </svg>
    <h1>Offside.</h1>
    <p>This page was never drawn.</p>
    <p>
      <a href="/">Back to the kick-off</a>
    </p>
    <p class="note">the flag was up early.</p>
  </section>
</Notebook>

<style>
  .lost {
    padding: 14svh 6% 0;
  }
  .lost h1 {
    margin: 10px 0 0;
    font-family: var(--font-script);
    font-size: clamp(3rem, 14vw, 5rem);
    line-height: 1;
    rotate: -2deg;
    transform-origin: left center;
  }
  .note {
    font-family: var(--font-script);
    font-size: 1.5rem;
    color: var(--crayon-blue);
  }
</style>
