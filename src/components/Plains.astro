---
// The North Texas plains under the night sky: a low, dark horizon and one windmill.
import { raggedEdge } from '../lib/brush';
---

<div class="plains" aria-hidden="true">
  <svg class="plains__land" viewBox="0 0 1200 60" preserveAspectRatio="none" focusable="false">
    <path d={raggedEdge(101, { height: 60, reach: 0.78 })} fill="#14285A"></path>
    <path d={raggedEdge(103, { height: 60, reach: 0.52 })} fill="#0A1230"></path>
  </svg>
  <svg class="plains__mill" viewBox="0 0 60 120" focusable="false">
    <!-- tower -->
    <path d="M21 120 29 40M39 120 31 40M23 100 37 86M37 100 24 86M25 80 35 68M35 80 26 68M27 62 33 52"></path>
    <!-- wheel -->
    <circle cx="30" cy="32" r="15"></circle>
    <path d="M30 32 30 17M30 32 40.6 21.4M30 32 45 32M30 32 40.6 42.6M30 32 30 47M30 32 19.4 42.6M30 32 15 32M30 32 19.4 21.4"></path>
    <!-- tail -->
    <path d="M30 32 54 27 58 22 58 34 54 29"></path>
  </svg>
</div>

<style>
  .plains {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(26px, 5vw, 60px);
    height: clamp(40px, 6vw, 70px);
    pointer-events: none;
  }
  .plains__land {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .plains__mill {
    position: absolute;
    right: 13%;
    bottom: 55%;
    height: clamp(70px, 11vw, 130px);
    overflow: visible;
  }
  .plains__mill path,
  .plains__mill circle {
    fill: none;
    stroke: #0a1230;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
