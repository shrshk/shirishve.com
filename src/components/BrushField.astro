---
// A painted ground: short strokes following one flow. Drawn at build time.
// By default the field is a repeating tile at a fixed scale, so the strokes
// keep their size however tall the section is. `fit` stretches one field to
// its box instead, for small canvases inside frames.
import { strokeField } from '../lib/brush';
import { surfaces, type StrokeSpec, type SurfaceName } from '../lib/palette';

interface Props {
  surface?: SurfaceName;
  seed?: number;
  fit?: boolean;
  /** Ground colour under a `fit` field. */
  base?: string;
  strokes?: StrokeSpec[];
  angle?: number;
  swirl?: number;
  cell?: number;
  width?: number;
  height?: number;
  length?: [number, number];
  thickness?: [number, number];
}
const { surface = 'night', seed = 1, fit = false, base, width = 1200, height = 800, ...rest } = Astro.props;
const s = surfaces[surface];
const layers = strokeField({
  seed,
  width,
  height,
  strokes: rest.strokes ?? s.strokes,
  angle: rest.angle ?? s.angle,
  swirl: rest.swirl ?? s.swirl,
  cell: rest.cell,
  length: rest.length,
  thickness: rest.thickness,
});
const id = `field-${surface}-${seed}`;
---

{fit ? (
  <svg
    class="brush-field"
    viewBox={`0 0 ${width} ${height}`}
    preserveAspectRatio="xMidYMid slice"
    style={base ? `background:${base}` : undefined}
    aria-hidden="true"
    focusable="false"
  >
    {layers.map((l) => (
      <path d={l.d} stroke={l.color} stroke-opacity={l.opacity} stroke-width={l.width} />
    ))}
  </svg>
) : (
  <svg class="brush-field" aria-hidden="true" focusable="false">
    <defs>
      <pattern id={id} width={width} height={height} patternUnits="userSpaceOnUse">
        {layers.map((l) => (
          <path d={l.d} stroke={l.color} stroke-opacity={l.opacity} stroke-width={l.width} />
        ))}
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#${id})`} />
  </svg>
)}

<style>
  .brush-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .brush-field path {
    fill: none;
    stroke-linecap: round;
  }
</style>
