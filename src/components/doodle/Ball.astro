---
// The ball that rides the thread. One element for the whole page: the script moves it.
// `still` draws the same ball inside a stage, for a page with no script.
interface Props {
  still?: boolean;
  x?: number;
  y?: number;
}
const { still = false, x = 0, y = 0 } = Astro.props;
const R = 12;
// A centre pentagon and five seams to the edge: enough to read as a football.
const corner = (i: number, r: number) => {
  const a = -Math.PI / 2 + (i * 2 * Math.PI) / 5;
  return [r * Math.cos(a), r * Math.sin(a)] as const;
};
const pent = Array.from({ length: 5 }, (_, i) => corner(i, 4.6));
const pentD = pent.map(([px, py], i) => `${i ? 'L' : 'M'}${px.toFixed(2)},${py.toFixed(2)}`).join('') + 'Z';
const seams = pent
  .map(([px, py], i) => {
    const [ex, ey] = corner(i, R - 0.6);
    return `M${px.toFixed(2)},${py.toFixed(2)}L${ex.toFixed(2)},${ey.toFixed(2)}`;
  })
  .join('');
const patches = Array.from({ length: 5 }, (_, i) => {
  const a = -Math.PI / 2 + ((i + 0.5) * 2 * Math.PI) / 5;
  const cx = (R - 1.2) * Math.cos(a);
  const cy = (R - 1.2) * Math.sin(a);
  return { cx, cy };
});
---

{still ? (
  <g class="still-ball" transform={`translate(${x} ${y})`}>
    <circle r={R} fill="#FFFDF6" stroke="#3B2F2A" stroke-width="1.8" />
    <path d={pentD} fill="#3B2F2A" />
    <path d={seams} fill="none" stroke="#3B2F2A" stroke-width="1.3" stroke-linecap="round" />
  </g>
) : (
  <div class="ball" data-ball hidden aria-hidden="true">
    <svg viewBox={`${-R - 2} ${-R - 2} ${2 * R + 4} ${2 * R + 4}`}>
      <defs>
        <clipPath id="ball-clip">
          <circle r={R - 0.6} />
        </clipPath>
      </defs>
      <circle r={R} fill="#FFFDF6" stroke="#3B2F2A" stroke-width="1.8" />
      <g clip-path="url(#ball-clip)">
        {patches.map((p) => (
          <circle cx={p.cx} cy={p.cy} r="3.4" fill="#3B2F2A" />
        ))}
      </g>
      <path d={pentD} fill="#3B2F2A" />
      <path d={seams} fill="none" stroke="#3B2F2A" stroke-width="1.3" stroke-linecap="round" />
    </svg>
  </div>
)}
