---
// The owner of the page as a doodle: quiff, beard, yellow puffer jacket.
// A 100 x 100 box with the feet near (50, 96), as the characters in doodle games.
// The rig is four groups that turn about a joint: two arms, two legs.
import Crayon from './Crayon.astro';

const SKIN = '#C98E63';
const SKIN_LINE = '#8A5A35';
const HAIR = '#2B211D';
const BEARD = '#4A3A32';
const JACKET = '#E9C24A';
const JACKET_LINE = '#A67C1F';
const TROUSER = '#4A4640';

interface Props {
  /** How far along the stage's thread the kick happens (0 to 1). */
  at?: number;
}
const { at } = Astro.props;
---

<g class:list={['me', at !== undefined && 'cue']} data-at={at}>
  <path
    d="M34,98 l8,-2 M44,99 l9,-2.4 M55,98.5 l8,-2"
    stroke="#9A8F80"
    stroke-width="1.1"
    stroke-linecap="round"
    opacity="0.7"
  ></path>

  <g class="me__leg me__leg--stand">
    <Crayon
      d="M40,77 C39,83 39.5,89 40.5,93 L47,93 C47.5,89 47.5,83 47,77 Z"
      fill={TROUSER}
      stroke={HAIR}
      width={1.4}
      dark
    />
    <ellipse cx="42.5" cy="94.5" rx="6" ry="3" fill="#F4F1EA" stroke={HAIR} stroke-width="1.4"></ellipse>
  </g>
  <g class="me__leg me__leg--kick">
    <Crayon
      d="M53,77 C52.5,83 53,89 53.5,93 L60,93 C61,89 60.5,83 60,77 Z"
      fill={TROUSER}
      stroke={HAIR}
      width={1.4}
      dark
    />
    <ellipse cx="58.5" cy="94.5" rx="6" ry="3" fill="#F4F1EA" stroke={HAIR} stroke-width="1.4"></ellipse>
  </g>

  <g class="me__arm me__arm--back">
    <Crayon
      d="M33,60 C27,62 23,67 22,72 C24,75 28,75 30,73 C31,69 34,66 37,64 Z"
      fill={JACKET}
      stroke={JACKET_LINE}
      width={1.6}
    />
    <circle cx="25.5" cy="75" r="3.6" fill={SKIN} stroke={SKIN_LINE} stroke-width="1.3"></circle>
  </g>

  <!-- the jacket, open over a mustard shirt -->
  <Crayon
    d="M32,58 C27,65 28,75 31,80 C40,83 60,83 69,80 C72,75 73,65 68,58 C61,54 39,54 32,58 Z"
    fill={JACKET}
    stroke={JACKET_LINE}
  />
  <path d="M45,56 L44,81.6 L56,81.6 L55,56 Z" fill="#C9A227"></path>
  <path
    d="M45,56 L44,81.6 M55,56 L56,81.6"
    fill="none"
    stroke={HAIR}
    stroke-width="2.2"
    stroke-linecap="round"
  ></path>
  <path
    d="M30,64.5 Q37,66.5 43,64.5 M29.5,72 Q37,74 43.5,72 M57,64.5 Q63,66.5 70,64.5 M56.5,72 Q63,74 70.5,72"
    fill="none"
    stroke={JACKET_LINE}
    stroke-width="1"
    stroke-linecap="round"
    opacity="0.8"
  ></path>
  <circle cx="50" cy="63" r="0.9" fill={SKIN_LINE}></circle>
  <circle cx="50" cy="71" r="0.9" fill={SKIN_LINE}></circle>

  <g class="me__arm me__arm--front">
    <Crayon
      d="M67,60 C73,62 77,67 78,72 C76,75 72,75 70,73 C69,69 66,66 63,64 Z"
      fill={JACKET}
      stroke={JACKET_LINE}
      width={1.6}
    />
    <circle cx="74.5" cy="75" r="3.6" fill={SKIN} stroke={SKIN_LINE} stroke-width="1.3"></circle>
  </g>

  <g class="me__head">
    <ellipse cx="29" cy="35" rx="2.8" ry="4" fill={SKIN} stroke={SKIN_LINE} stroke-width="1.3"></ellipse>
    <ellipse cx="71" cy="35" rx="2.8" ry="4" fill={SKIN} stroke={SKIN_LINE} stroke-width="1.3"></ellipse>
    <path
      d="M50,11 C62,11 71,20 71,33 C71,46 62,57 50,57 C38,57 29,46 29,33 C29,20 38,11 50,11 Z"
      fill={SKIN}
      stroke={SKIN_LINE}
      stroke-width="1.8"
    ></path>
    <!-- a trimmed beard: a soft band along the jaw, and a moustache -->
    <path
      d="M29.6,37 C31,49 39,57.4 50,57.4 C61,57.4 69,49 70.4,37 C69.5,39 68.6,40 67.4,40.6 C66,47.5 59,52.2 50,52.2 C41,52.2 34,47.5 32.6,40.6 C31.4,40 30.5,39 29.6,37 Z"
      fill={BEARD}
      opacity="0.78"
    ></path>
    <path
      d="M38,52 l1,2.4 M42.5,53.4 l0.6,2.6 M47.5,54 l0.2,2.6 M52.5,54 l-0.2,2.6 M57.5,53.4 l-0.6,2.6 M62,52 l-1,2.4 M34,46 l-1.6,1.6 M66,46 l1.6,1.6"
      fill="none"
      stroke={SKIN}
      stroke-width="0.7"
      stroke-linecap="round"
      opacity="0.55"
    ></path>
    <path
      d="M42,44.6 Q46,42.2 50,43.4 Q54,42.2 58,44.6 Q54,44 50,44.4 Q46,44 42,44.6 Z"
      fill={BEARD}
      opacity="0.85"
    ></path>
    <path
      d="M43.4,45.8 Q50,52.4 56.6,45.8 Q50,47 43.4,45.8 Z"
      fill="#FFFDF6"
      stroke={HAIR}
      stroke-width="0.9"
    ></path>
    <!-- the quiff: swept up and to one side -->
    <path
      d="M28.8,30 C27.4,20 31.5,12.5 38.5,9.8 C40,5.2 45.5,3.4 48.6,6.2 C51.5,1.4 57.6,1 60.4,4.6 C64.6,2.4 69.4,5.6 68,10.4 C72.6,14.4 73.2,22 71.2,30 C69.8,25 67,21.4 62.6,19.8 C64,17 63,14.6 60.6,13.6 C57.4,18.4 50.5,19.6 44.5,19.2 C38,19 32.6,23 28.8,30 Z"
      fill={HAIR}
    ></path>
    <path
      d="M40,12 C44,8.5 50,7.5 55,9 M36,17 C42,13 50,12.5 57,13.5 M62,8.5 C65,9.5 67,12 67.5,15"
      fill="none"
      stroke="#6B5A4E"
      stroke-width="1"
      stroke-linecap="round"
      opacity="0.8"
    ></path>
    <path
      d="M35.5,27 Q40,24.6 44.5,26.4 M55.5,26.4 Q60,24.6 64.5,27"
      fill="none"
      stroke={HAIR}
      stroke-width="1.8"
      stroke-linecap="round"
    ></path>
    <ellipse cx="35" cy="39.5" rx="3.4" ry="2" fill="#F28B9A" opacity="0.45"></ellipse>
    <ellipse cx="65" cy="39.5" rx="3.4" ry="2" fill="#F28B9A" opacity="0.45"></ellipse>
    <g class="me__eyes">
      <circle cx="40.5" cy="33.5" r="3.3" fill={HAIR}></circle>
      <circle cx="59.5" cy="33.5" r="3.3" fill={HAIR}></circle>
      <circle cx="41.6" cy="32.2" r="1.2" fill="#fff"></circle>
      <circle cx="60.6" cy="32.2" r="1.2" fill="#fff"></circle>
    </g>
  </g>
</g>

<style is:global>
  /* Each limb turns about its joint. Only transforms change, and nothing here is
     inside an SVG filter, so a phone does not repaint the drawing. */
  .me__leg,
  .me__arm,
  .me__head {
    transform-box: view-box;
    transition: transform 240ms cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .me__leg--kick {
    transform-origin: 56.5px 78px;
    transform: rotate(9deg);
  }
  .me__leg--stand {
    transform-origin: 43.5px 78px;
  }
  .me__arm--back {
    transform-origin: 34px 61px;
  }
  .me__arm--front {
    transform-origin: 66px 61px;
  }
  .me__head {
    transform-origin: 50px 56px;
  }
  /* the kick: leg through, arms out for balance, head up to watch the ball */
  .me.on .me__leg--kick {
    transform: rotate(-58deg);
  }
  .me.on .me__arm--back {
    transform: rotate(48deg);
  }
  .me.on .me__arm--front {
    transform: rotate(-62deg);
  }
  .me.on .me__head {
    transform: rotate(7deg);
  }
  .thread-live .me.cue {
    opacity: 1;
  }
</style>
