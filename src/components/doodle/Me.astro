---
// The owner of the page as a doodle: quiff, beard, yellow puffer jacket.
// A 100 x 100 box with the feet near (50, 96), as the characters in doodle games.
// The rig is four groups that turn about a joint: two arms, two legs.
import Crayon from './Crayon.astro';

const SKIN = '#C98E63';
const SKIN_LINE = '#8A5A35';
const HAIR = '#2B211D';
const HEAD =
  'M50,9 C61,9 69.5,18 69.5,31 C69.5,40 67,48.5 61,54 C57.5,57.2 53.5,58.4 50,58.4 C46.5,58.4 42.5,57.2 39,54 C33,48.5 30.5,40 30.5,31 C30.5,18 39,9 50,9 Z';
const JACKET = '#E9C24A';
const JACKET_LINE = '#A67C1F';
const TROUSER = '#4A4640';

interface Props {
  /** How far along the stage's thread the kick happens (0 to 1). */
  at?: number;
  /** What the doodle does at that moment. */
  pose?: 'kick' | 'cheer';
}
const { at, pose = 'kick' } = Astro.props;
---

<g class:list={['me', `me--${pose}`, at !== undefined && 'cue']} data-at={at}>
  <path
    d="M34,98 l8,-2 M44,99 l9,-2.4 M55,98.5 l8,-2"
    stroke="#9A8F80"
    stroke-width="1.1"
    stroke-linecap="round"
    opacity="0.7"
  ></path>

  <g class="me__leg me__leg--stand">
    <Crayon
      d="M40,77 C39,83 39.5,89 40.5,93 L47,93 C47.5,89 47.5,83 47,77 Z"
      fill={TROUSER}
      stroke={HAIR}
      width={1.4}
      dark
    />
    <ellipse cx="42.5" cy="94.5" rx="6" ry="3" fill="#F4F1EA" stroke={HAIR} stroke-width="1.4"></ellipse>
  </g>
  <g class="me__leg me__leg--kick">
    <Crayon
      d="M53,77 C52.5,83 53,89 53.5,93 L60,93 C61,89 60.5,83 60,77 Z"
      fill={TROUSER}
      stroke={HAIR}
      width={1.4}
      dark
    />
    <ellipse cx="58.5" cy="94.5" rx="6" ry="3" fill="#F4F1EA" stroke={HAIR} stroke-width="1.4"></ellipse>
  </g>

  <g class="me__arm me__arm--back">
    <Crayon
      d="M33,60 C27,62 23,67 22,72 C24,75 28,75 30,73 C31,69 34,66 37,64 Z"
      fill={JACKET}
      stroke={JACKET_LINE}
      width={1.6}
    />
    <circle cx="25.5" cy="75" r="3.6" fill={SKIN} stroke={SKIN_LINE} stroke-width="1.3"></circle>
  </g>

  <!-- the jacket, open over a mustard shirt -->
  <Crayon
    d="M32,58 C27,65 28,75 31,80 C40,83 60,83 69,80 C72,75 73,65 68,58 C61,54 39,54 32,58 Z"
    fill={JACKET}
    stroke={JACKET_LINE}
  />
  <path d="M45,56 L44,81.6 L56,81.6 L55,56 Z" fill="#C9A227"></path>
  <path
    d="M45,56 L44,81.6 M55,56 L56,81.6"
    fill="none"
    stroke={HAIR}
    stroke-width="2.2"
    stroke-linecap="round"
  ></path>
  <path
    d="M30,64.5 Q37,66.5 43,64.5 M29.5,72 Q37,74 43.5,72 M57,64.5 Q63,66.5 70,64.5 M56.5,72 Q63,74 70.5,72"
    fill="none"
    stroke={JACKET_LINE}
    stroke-width="1"
    stroke-linecap="round"
    opacity="0.8"
  ></path>
  <circle cx="50" cy="63" r="0.9" fill={SKIN_LINE}></circle>
  <circle cx="50" cy="71" r="0.9" fill={SKIN_LINE}></circle>

  <g class="me__arm me__arm--front">
    <Crayon
      d="M67,60 C73,62 77,67 78,72 C76,75 72,75 70,73 C69,69 66,66 63,64 Z"
      fill={JACKET}
      stroke={JACKET_LINE}
      width={1.6}
    />
    <circle cx="74.5" cy="75" r="3.6" fill={SKIN} stroke={SKIN_LINE} stroke-width="1.3"></circle>
  </g>

  <g class="me__head">
    <ellipse cx="29.5" cy="34" rx="2.8" ry="4" fill={SKIN} stroke={SKIN_LINE} stroke-width="1.3"></ellipse>
    <ellipse cx="70.5" cy="34" rx="2.8" ry="4" fill={SKIN} stroke={SKIN_LINE} stroke-width="1.3"></ellipse>
    <path d={HEAD} fill={SKIN} stroke={SKIN_LINE} stroke-width="1.8"></path>
    <!-- a short beard: a shadow over the jaw, not a solid shape -->
    <clipPath id="me-face">
      <path d={HEAD}></path>
    </clipPath>
    <path
      clip-path="url(#me-face)"
      d="M26,38 C32,43.5 37,43.5 42,42 C46,40.4 54,40.4 58,42 C63,43.5 68,43.5 74,38 L74,62 L26,62 Z"
      fill={HAIR}
      opacity="0.34"
    ></path>
    <path
      d="M41.8,45.5 Q50,55 58.2,45.5 Q50,47.5 41.8,45.5 Z"
      fill="#FFFDF6"
      stroke={HAIR}
      stroke-width="1"
    ></path>
    <ellipse cx="35.4" cy="39.6" rx="3.4" ry="2" fill="#F28B9A" opacity="0.5"></ellipse>
    <ellipse cx="64.6" cy="39.6" rx="3.4" ry="2" fill="#F28B9A" opacity="0.5"></ellipse>
    <!-- short sides, the top swept up and across in three locks, an uneven hairline -->
    <path
      d="M30.6,34 C30,28 29.4,22 30,17 C30.6,12.5 32.5,9.5 35.5,8 C38,3.5 44,2.5 47.5,5 C50.5,0.5 58.5,-0.5 62.5,3 C66.5,2 70.5,5.5 69,10.5 C70.8,15 70.8,24 69.4,34 C68.8,30 68,27 66.6,25 C66,22 64.5,20 62,19 C58,18 55,19.6 52,19.2 C48,18.6 45,17.4 41,17.8 C37.5,18.2 35.2,20 34,23 C32.4,25.5 31.4,29 30.6,34 Z"
      fill={HAIR}
    ></path>
    <path
      d="M37,15 C42,9 50,7 57,8.5 M44,16 C49,11 57,9.5 64,11.5 M34,12 C36,9.5 39,8 42,7.5"
      fill="none"
      stroke="#6B5A4E"
      stroke-width="0.9"
      stroke-linecap="round"
      opacity="0.85"
    ></path>
    <path
      d="M36,26.4 Q40.2,24 44.6,25.6 M55.4,25.6 Q59.8,24 64,26.4"
      fill="none"
      stroke={HAIR}
      stroke-width="1.7"
      stroke-linecap="round"
    ></path>
    <g class="me__eyes">
      <!-- open eyes, lifted from below by the smile -->
      <path
        d="M37.6,34.6 A3.5,3.7 0 1 1 44.4,34.6 Q41,32.2 37.6,34.6 Z M55.6,34.6 A3.5,3.7 0 1 1 62.4,34.6 Q59,32.2 55.6,34.6 Z"
        fill={HAIR}
      ></path>
      <circle cx="42.2" cy="31.4" r="1.1" fill="#fff"></circle>
      <circle cx="60.2" cy="31.4" r="1.1" fill="#fff"></circle>
    </g>
  </g>
</g>

<style is:global>
  /* Each limb turns about its joint. Only transforms change, and nothing here is
     inside an SVG filter, so a phone does not repaint the drawing. */
  .me__leg,
  .me__arm,
  .me__head {
    transform-box: view-box;
    transition: transform 240ms cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .me__leg--kick {
    transform-origin: 56.5px 78px;
    transform: rotate(9deg);
  }
  .me__leg--stand {
    transform-origin: 43.5px 78px;
  }
  .me__arm--back {
    transform-origin: 34px 61px;
  }
  .me__arm--front {
    transform-origin: 66px 61px;
  }
  .me__head {
    transform-origin: 50px 56px;
  }
  /* the kick: leg through, arms out for balance, head up to watch the ball */
  .me--kick.on .me__leg--kick {
    transform: rotate(-58deg);
  }
  .me--kick.on .me__arm--back {
    transform: rotate(48deg);
  }
  .me--kick.on .me__arm--front {
    transform: rotate(-62deg);
  }
  .me--kick.on .me__head {
    transform: rotate(7deg);
  }
  /* the cheer: both arms up */
  .me--cheer .me__leg--kick {
    transform: none;
  }
  .me--cheer.on .me__arm--back {
    transform: rotate(125deg);
  }
  .me--cheer.on .me__arm--front {
    transform: rotate(-125deg);
  }
  .me--cheer.on .me__head {
    transform: rotate(-5deg);
  }
  .thread-live .me.cue {
    opacity: 1;
  }
</style>
