---
// A note between two drawings. The thread runs down the right margin beside it.
import { MARGIN_X, STAGE_W, hand } from '../../lib/doodle';

interface Props {
  seed: number;
  id?: string;
}
const { seed, id } = Astro.props;
// Stretched to the height of the note, so the wobble is drawn for a 100-unit drop.
const thread = hand(
  [
    [MARGIN_X, 0],
    [MARGIN_X, 100],
  ],
  seed,
  2.2,
);
---

<section class="gap" data-segment id={id}>
  <svg class="gap__thread" viewBox={`0 0 ${STAGE_W} 100`} preserveAspectRatio="none" aria-hidden="true">
    <path class="thread" data-thread d={thread} pathLength="1"></path>
  </svg>
  <div class="slip">
    <slot />
  </div>
</section>
