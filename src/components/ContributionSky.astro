---
// The contribution year as a night sky: one star per day, brighter on busier days.
import BrushField from './BrushField.astro';
import Frame from './Frame.astro';
import { rng } from '../lib/brush';
import type { Day } from '../lib/github';
import { palette } from '../lib/palette';

interface Props {
  days: Day[];
}
const { days } = Astro.props;

const CELL = 20;
const first = new Date(days[0].date + 'T00:00:00Z');
const offset = first.getUTCDay();
const weeks = Math.ceil((days.length + offset) / 7);
const W = weeks * CELL + CELL;
const H = 7 * CELL + CELL;
const rand = rng(365);

const stars = days.map((d, i) => {
  const slot = i + offset;
  return {
    x: Math.floor(slot / 7) * CELL + CELL + (rand() - 0.5) * 7,
    y: (slot % 7) * CELL + CELL + (rand() - 0.5) * 7,
    level: d.level,
    turn: Math.round(rand() * 360),
  };
});
const active = days.filter((d) => d.level > 0).length;
const sky = [
  { color: '#0A1230', opacity: 0.8, weight: 3 },
  { color: palette.cobalt, opacity: 0.6, weight: 3 },
  { color: '#2A5FA3', opacity: 0.35, weight: 1 },
];
// size, colour and opacity of a star at each level
const look = [
  { r: 0.9, fill: '#6F8FC4', o: 0.4 },
  { r: 2.3, fill: '#FBF4DF', o: 0.95 },
  { r: 2.9, fill: '#F7DC7A', o: 1 },
  { r: 3.6, fill: palette.chrome, o: 1 },
  { r: 4.3, fill: palette.chrome, o: 1 },
];
---

<Frame
  ratio={`${W} / ${H}`}
  alt={`The last year on GitHub drawn as ${days.length} stars. ${active} of them are lit: days with public activity.`}
>
  <BrushField
    seed={365}
    fit
    base={palette.night}
    width={W}
    height={H}
    strokes={sky}
    cell={15}
    length={[20, 46]}
    thickness={[5, 10]}
    angle={-0.2}
    swirl={1.4}
  />
  <svg class="year-stars" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
    {stars.map((s) => (
      <>
        {s.level >= 3 && (
          <circle
            cx={s.x.toFixed(1)}
            cy={s.y.toFixed(1)}
            r={s.level === 4 ? 7.6 : 6.2}
            fill="none"
            stroke="#F7DC7A"
            stroke-width="1.5"
            stroke-opacity={s.level === 4 ? 0.9 : 0.6}
            stroke-dasharray="3.5 2.6"
            stroke-linecap="round"
            transform={`rotate(${s.turn} ${s.x.toFixed(1)} ${s.y.toFixed(1)})`}
          />
        )}
        <circle
          cx={s.x.toFixed(1)}
          cy={s.y.toFixed(1)}
          r={look[s.level].r}
          fill={look[s.level].fill}
          fill-opacity={look[s.level].o}
        />
      </>
    ))}
  </svg>
  <Fragment slot="plate">
    <strong class="plate-title">A year of commits</strong>
    <span class="mono plate-stats">
      {active} lit days of {days.length}
    </span>
  </Fragment>
</Frame>

<style>
  .year-stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>
