---
// Section 2: a sunlit room. Dawn. The sun comes up behind the portrait.
import BrushDivider from './BrushDivider.astro';
import Frame from './Frame.astro';
import MarginNote from './MarginNote.astro';
import Signature from './Signature.astro';
import Sun from './Sun.astro';
import Sunflowers from './Sunflowers.astro';
import Surface from './Surface.astro';
import VermilionStroke from './VermilionStroke.astro';
import { show, site } from '../lib/content';
const [first, ...rest] = site.bio;
---

<Surface name="canvas" seed={23} id="about">
  <div class="wrap about">
    <div class="about__words">
      <h2>About</h2>
      <VermilionStroke seed={7} width="7rem" />
      {first && (
        <>
          <p class="about__label mono">Proposition.</p>
          <p class="about__big">
            <span>{show(first)}</span>
          </p>
        </>
      )}
      {rest.map((p, i) => (
        <p class="about__more">
          {i === 0 && <em class="about__proof">Proof. </em>}
          {show(p)}
          {i === rest.length - 1 && (
            <span class="about__qed" title="Which was to be shown.">
              {' '}
              ∎
            </span>
          )}
        </p>
      ))}
      <div class="about__query paint">
        <p class="mono about__sql">
          <span class="kw">SELECT</span> topic, why <span class="kw">FROM</span> loves{' '}
          <span class="kw">ORDER BY</span> depth <span class="kw">DESC</span>;
        </p>
        <table>
          <tbody>
            {site.loves.map((l) => (
              <tr>
                <th scope="row" class="mono">
                  {l.topic}
                </th>
                <td>{l.why}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="mono about__rows">({site.loves.length} rows) · Index Scan · cost O(log n)</p>
      </div>
      <div class="about__garden">
        <div class="about__flowers">
          <Sunflowers seed={31} />
        </div>
        <MarginNote rotate={-3} arrow="left">
          each seed turns 137.5° from the last. the golden angle.
        </MarginNote>
      </div>
    </div>

    <div class="about__portrait">
      <div class="about__sun">
        <Sun seed={19} />
      </div>
      <Frame tilt={1.4} ratio="4 / 5">
        <img
          class="about__photo"
          src="/images/portrait.webp"
          width="640"
          height="800"
          alt={`A painted portrait of ${site.name}: smiling, in a yellow jacket, against a swirling blue sky`}
          loading="lazy"
          decoding="async"
        />
        <Fragment slot="plate">
          <strong class="plate-title">Self-portrait</strong>
          <span class="mono plate-stats">104,174 strokes</span>
        </Fragment>
      </Frame>
      <div class="about__note">
        <MarginNote rotate={-3} arrow="up-left">
          the desk is remote. so is the team.
        </MarginNote>
      </div>
    </div>
    <Signature seed={5} />
  </div>
  <BrushDivider slot="divider" to="wheat" seed={47} />
</Surface>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: 3rem clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .about__words {
    position: relative;
    z-index: 1;
  }
  .about h2 {
    font-size: var(--step-4);
    line-height: 0.95;
    margin-bottom: 0.6rem;
  }
  .about__label {
    margin: 2rem 0 0;
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .about__proof {
    font-weight: 600;
  }
  .about__qed {
    white-space: nowrap;
  }
  .about__big {
    max-width: 18ch;
    margin: 0.5rem 0 1.4rem;
    font-family: var(--font-display);
    font-variation-settings:
      'SOFT' 100,
      'WONK' 1;
    font-size: var(--step-3);
    font-weight: 700;
    line-height: 1.12;
  }
  /* A stroke of chrome yellow under every line of the sentence. */
  .about__big span {
    background: linear-gradient(transparent 58%, var(--chrome) 58% 92%, transparent 92%);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    padding-inline: 0.12em;
  }
  .about__more {
    max-width: 36ch;
    font-size: var(--step-1);
  }
  /* A query result on a sheet of paper. */
  .about__query {
    --paint: #f7efd9;
    max-width: 36rem;
    margin-top: 2rem;
    padding: 1.1rem 1.3rem 1rem;
    color: var(--night);
    rotate: -0.6deg;
  }
  .about__sql {
    margin: 0 0 0.7rem;
    font-size: var(--step--1);
    font-weight: 600;
  }
  .about__sql .kw {
    color: var(--cobalt);
  }
  .about__query table {
    width: 100%;
    border-collapse: collapse;
  }
  .about__query th,
  .about__query td {
    padding: 0.42rem 0;
    text-align: left;
    vertical-align: baseline;
    border-top: 2px dotted color-mix(in srgb, var(--night) 35%, transparent);
  }
  .about__query th {
    padding-right: 1.2rem;
    font-size: var(--step--1);
    font-weight: 700;
    white-space: nowrap;
  }
  .about__rows {
    margin: 0.7rem 0 0;
    font-size: 0.78rem;
  }
  .about__garden {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: 2.5rem;
  }
  .about__flowers {
    flex: 0 0 min(100%, 17rem);
  }
  .about__portrait {
    position: relative;
    max-width: 24rem;
    justify-self: center;
    width: 100%;
  }
  .about__photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about__sun {
    position: absolute;
    top: 42%;
    left: 50%;
    width: 200%;
    translate: -50% -50%;
  }
  .about__portrait :global(.frame),
  .about__note {
    position: relative;
  }
  .about__note {
    margin-top: 1.4rem;
    padding-left: 2rem;
  }
  @media (max-width: 46rem) {
    .about {
      grid-template-columns: 1fr;
    }
    .about__query th {
      white-space: normal;
    }
    .about__portrait {
      max-width: 17rem;
    }
  }
</style>
