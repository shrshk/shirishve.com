---
// Section 3: wheatfield at noon.
import BrushDivider from './BrushDivider.astro';
import MarginNote from './MarginNote.astro';
import Signature from './Signature.astro';
import Surface from './Surface.astro';
import VermilionStroke from './VermilionStroke.astro';
import { show, site } from '../lib/content';
---

<Surface name="wheat" seed={37} id="work">
  <div class="wrap work">
    <div>
      <h2>Work</h2>
      <p class="lede">{show(site.work.summary)}</p>
      <h3>Scheduling problems I solve</h3>
      <ol class="problems">
        {site.work.problems.map((x) => (
          <li>
            <strong>{x.problem}</strong>
            <span>{x.answer}</span>
          </li>
        ))}
      </ol>
      <h3>At what scale</h3>
      <ul class="scale">
        {site.work.scale.map((x) => (
          <li>
            <strong>{x.figure}</strong>
            <span>{x.label}</span>
          </li>
        ))}
      </ul>
      <h3>What I work on</h3>
      <ul class="tags">
        {site.work.focus.map((f) => (
          <li class="tag paint">{f}</li>
        ))}
      </ul>
    </div>
    <div class="plan">
      <p class="plan__query mono">EXPLAIN ANALYZE SELECT * FROM career;</p>
      <VermilionStroke seed={12} width="6rem" />
      <div class="plan__note">
        <MarginNote rotate={-2} arrow="up-left">
          {site.work.explainNote}
        </MarginNote>
      </div>
    </div>
    <Signature seed={8} />
  </div>
  <BrushDivider slot="divider" to="wall" seed={59} />
</Surface>

<style>
  .work {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    gap: 2.5rem clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .work h3 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .problems {
    display: grid;
    gap: 1.1rem;
    max-width: 44rem;
    padding: 0;
    margin: 0;
    list-style: none;
    counter-reset: problem;
  }
  .problems li {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    column-gap: 0.4rem;
    counter-increment: problem;
  }
  .problems li::before {
    content: counter(problem) '.';
    grid-row: span 2;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    line-height: 1;
  }
  .problems strong {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.2;
  }
  .scale {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1.6rem 2.2rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .scale li {
    display: grid;
    gap: 0.2rem;
    padding-top: 0.7rem;
    border-top: 3px solid var(--night);
  }
  .scale strong {
    font-family: var(--font-display);
    font-variation-settings:
      'SOFT' 100,
      'WONK' 1;
    font-size: var(--step-2);
    font-weight: 800;
    line-height: 1.05;
    white-space: nowrap;
  }
  .scale span {
    max-width: 28ch;
  }
  .plan__query {
    margin-bottom: 0.6rem;
    font-size: var(--step-0);
    font-weight: 600;
  }
  .plan__note {
    margin-top: 1.2rem;
    padding-left: 1.5rem;
  }
  @media (max-width: 46rem) {
    .work {
      grid-template-columns: 1fr;
    }
  }
</style>
