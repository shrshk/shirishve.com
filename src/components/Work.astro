---
// Section 3: wheatfield at noon.
import BrushDivider from './BrushDivider.astro';
import MarginNote from './MarginNote.astro';
import Signature from './Signature.astro';
import Surface from './Surface.astro';
import VermilionStroke from './VermilionStroke.astro';
import { show, site } from '../lib/content';
---

<Surface name="wheat" seed={37} id="work">
  <div class="wrap work">
    <div>
      <h2>Work</h2>
      <p class="lede">{show(site.work.summary)}</p>
      <h3>What I work on</h3>
      <ul class="tags">
        {site.work.focus.map((f) => (
          <li class="tag paint">{f}</li>
        ))}
      </ul>
    </div>
    <div class="plan">
      <p class="plan__query mono">EXPLAIN SELECT * FROM career;</p>
      <VermilionStroke seed={12} width="6rem" />
      <div class="plan__note">
        <MarginNote rotate={-2} arrow="up-left">
          {site.work.explainNote}
        </MarginNote>
      </div>
    </div>
    <Signature seed={8} />
  </div>
  <BrushDivider slot="divider" to="wall" seed={59} />
</Surface>

<style>
  .work {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    gap: 2.5rem clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .work h3 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .plan__query {
    margin-bottom: 0.6rem;
    font-size: var(--step-0);
    font-weight: 600;
  }
  .plan__note {
    margin-top: 1.2rem;
    padding-left: 1.5rem;
  }
  @media (max-width: 46rem) {
    .work {
      grid-template-columns: 1fr;
    }
  }
</style>
