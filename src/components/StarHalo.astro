---
// A star the way the hero will draw them: a core and concentric dashed halos.
import { rng } from '../lib/brush';

interface Props {
  seed?: number;
  /** CSS size. */
  size?: string;
  rings?: number;
}
const { seed = 1, size = '7rem', rings = 4 } = Astro.props;
const rand = rng(seed);
const halos = Array.from({ length: rings }, (_, i) => {
  const r = 9 + i * 9.5 + rand() * 2;
  const dash = 5 + rand() * 9;
  return {
    r,
    dash: `${dash.toFixed(1)} ${(dash * (0.5 + rand() * 0.6)).toFixed(1)}`,
    offset: (rand() * 30).toFixed(1),
    width: (4.6 - i * 0.6).toFixed(1),
    color: i % 2 ? '#F7DC7A' : '#F2C230',
    opacity: (0.95 - i * 0.17).toFixed(2),
  };
});
---

<svg
  class="star-halo"
  viewBox="0 0 100 100"
  style={`width:${size};height:${size}`}
  aria-hidden="true"
  focusable="false"
>
  {halos.map((h) => (
    <circle
      cx="50"
      cy="50"
      r={h.r}
      fill="none"
      stroke={h.color}
      stroke-width={h.width}
      stroke-dasharray={h.dash}
      stroke-dashoffset={h.offset}
      stroke-opacity={h.opacity}
      stroke-linecap="round"
    />
  ))}
  <circle cx="50" cy="50" r="5.5" fill="#FBF4DF"></circle>
</svg>

<style>
  .star-halo {
    display: block;
    overflow: visible;
  }
</style>
