---
// Wide screens: a strip of paint with the section links.
// Small screens: a team sheet. The links line up as a 4-3-3 on a painted pitch.
import * as icons from 'simple-icons';
import { site } from '../lib/content';

const sections = [
  { href: '#about', label: 'About' },
  { href: '#work', label: 'Work' },
  { href: '#projects', label: 'Projects' },
  { href: '#terrace', label: 'Terrace' },
  { href: '#contact', label: 'Contact' },
];

interface Player {
  label?: string;
  href?: string;
}
const cap = (word: string) => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();
const brand = icons as unknown as Record<string, { title: string } | undefined>;
const social = site.socials.map((s) => ({
  label: brand['si' + cap(s.platform)]?.title ?? (s.platform === 'linkedin' ? 'LinkedIn' : cap(s.platform)),
  href: s.url,
}));
// Eleven shirts. A place without a link is still a player; it just has no name on its back.
const pad = (players: Player[], n: number): Player[] => [...players, ...Array(n).fill({})].slice(0, n);
const lines: { name: string; players: Player[] }[] = [
  { name: 'Forwards', players: pad(social.slice(1, 4), 3) },
  {
    name: 'Midfield',
    // The first profile and any fifth one play here; the styleguide fills a free shirt.
    players: pad(
      [
        sections[4],
        ...social.slice(0, 1),
        ...social.slice(4, 5),
        { href: '/styleguide/', label: 'Styleguide' },
      ],
      3,
    ),
  },
  { name: 'Defence', players: sections.slice(0, 4) },
  { name: 'Goalkeeper', players: [{ href: '#top', label: 'Top' }] },
];
---

<nav class="nav" aria-label="Sections">
  <ul class="nav__strip paint">
    {sections.map((s) => (
      <li>
        <a href={s.href}>{s.label}</a>
      </li>
    ))}
  </ul>

  <details class="nav__sheet" data-sheet>
    <summary class="paint">
      <span class="nav__open">Team sheet</span>
      <span class="nav__close">Close</span>
    </summary>
    <div class="pitch">
      <svg class="pitch__lines" viewBox="0 0 300 440" preserveAspectRatio="none" aria-hidden="true">
        <path d="M8 8H292V432H8ZM8 220H292M90 8V62H210V8M90 432V378H210V432"></path>
        <circle cx="150" cy="220" r="42"></circle>
      </svg>
      <p class="pitch__title">4-3-3</p>
      {lines.map((line) => (
        <ul class="pitch__line" aria-label={line.name}>
          {line.players.map((p) => (
            <li>
              {p.href ? (
                <a class="shirt" href={p.href}>
                  <span class="shirt__dot" />
                  {p.label}
                </a>
              ) : (
                <span class="shirt shirt--bench" aria-hidden="true">
                  <span class="shirt__dot" />
                </span>
              )}
            </li>
          ))}
        </ul>
      ))}
    </div>
  </details>
</nav>

<script>
  // Close the team sheet after a link is chosen, and on Escape.
  const sheet = document.querySelector<HTMLDetailsElement>('[data-sheet]');
  if (sheet) {
    sheet.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) sheet.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && sheet.open) {
        sheet.open = false;
        sheet.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .nav {
    position: fixed;
    top: 0.9rem;
    right: var(--gutter);
    z-index: 20;
    --link: var(--night);
    --ring-gap: var(--night);
  }
  .nav__strip {
    --paint: var(--canvas);
    display: flex;
    gap: 0.2rem;
    padding: 0.15rem 0.6rem 0.25rem;
    margin: 0;
    list-style: none;
    rotate: -0.5deg;
  }
  .nav__strip::before {
    inset: 0 -4px;
    border-radius: 0.6em 1em 0.7em 0.9em / 1em 0.6em 0.9em 0.7em;
  }
  .nav__strip a {
    display: block;
    padding: 0.45rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--night);
    text-decoration: none;
  }
  .nav__strip a:hover {
    text-decoration: underline wavy var(--vermilion);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .nav__sheet {
    display: none;
  }
  .nav__sheet summary {
    --paint: var(--canvas);
    position: relative;
    z-index: 2;
    width: fit-content;
    margin-left: auto;
    padding: 0.6rem 0.9rem 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--night);
    list-style: none;
    cursor: pointer;
    rotate: -1deg;
  }
  .nav__sheet summary::-webkit-details-marker {
    display: none;
  }
  .nav__sheet summary::before {
    border-radius: 0.6em 1em 0.7em 0.9em / 1em 0.6em 0.9em 0.7em;
  }
  .nav__close,
  .nav__sheet[open] .nav__open {
    display: none;
  }
  .nav__sheet[open] .nav__close {
    display: inline;
  }

  .pitch {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: grid;
    grid-template-rows: auto repeat(4, 1fr);
    padding: 4.6rem 1.2rem 1.6rem;
    background:
      repeating-linear-gradient(180deg, transparent 0 12.5%, rgb(255 255 255 / 0.045) 12.5% 25%),
      var(--cypress);
    color: var(--canvas);
    overflow-y: auto;
  }
  .pitch__lines {
    position: absolute;
    inset: 3.8rem 0.6rem 0.8rem;
    width: calc(100% - 1.2rem);
    height: calc(100% - 4.6rem);
    filter: url(#rough-fine);
  }
  .pitch__lines path,
  .pitch__lines circle {
    fill: none;
    stroke: var(--canvas);
    stroke-opacity: 0.55;
    stroke-width: 3;
    vector-effect: non-scaling-stroke;
  }
  .pitch__title {
    position: relative;
    margin: 0;
    font-family: var(--font-hand);
    font-size: 1.5rem;
    line-height: 1;
    text-align: center;
  }
  .pitch__line {
    position: relative;
    display: flex;
    justify-content: space-evenly;
    align-items: center;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .shirt {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    min-width: 4rem;
    padding: 0.4rem 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--canvas);
    text-decoration: none;
  }
  /* Red shirt, white sleeves: colour only. */
  .shirt__dot {
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 46% 54% 50% 50% / 52% 48% 52% 48%;
    background: var(--vermilion);
    box-shadow:
      -0.5rem 0 0 -0.55rem #f7efd9,
      0 0 0 3px #f7efd9;
  }
  .shirt--bench .shirt__dot {
    opacity: 0.45;
  }

  @media (max-width: 46rem) {
    .nav__strip {
      display: none;
    }
    .nav__sheet {
      display: block;
    }
  }
</style>
