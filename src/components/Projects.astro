---
// Section 4: a gallery wall. Afternoon. Repos come from GitHub when the site is built.
import BrushDivider from './BrushDivider.astro';
import BrushField from './BrushField.astro';
import ContributionSky from './ContributionSky.astro';
import Frame from './Frame.astro';
import MarginNote from './MarginNote.astro';
import Signature from './Signature.astro';
import Surface from './Surface.astro';
import VermilionStroke from './VermilionStroke.astro';
import { rng } from '../lib/brush';
import { site } from '../lib/content';
import { ago, github } from '../lib/github';
import { palette, type StrokeSpec } from '../lib/palette';

const { repos, days, fetchedAt } = await github();

// Each repo gets its own small painting, fixed by its name: sunflowers, in a few moods.
const moods: { base: string; strokes: StrokeSpec[] }[] = [
  {
    base: palette.blossom,
    strokes: [
      { color: palette.chrome, opacity: 0.92, weight: 4 },
      { color: palette.ochre, opacity: 0.88, weight: 3 },
      { color: '#8A5A10', opacity: 0.75, weight: 1 },
      { color: '#A8DDD5', opacity: 0.8, weight: 2 },
    ],
  },
  {
    base: palette.chrome,
    strokes: [
      { color: '#F8E08A', opacity: 0.9, weight: 3 },
      { color: palette.ochre, opacity: 0.9, weight: 3 },
      { color: palette.cypress, opacity: 0.7, weight: 1 },
      { color: '#B9552E', opacity: 0.6, weight: 1 },
    ],
  },
  {
    base: palette.cobalt,
    strokes: [
      { color: palette.sky, opacity: 0.85, weight: 3 },
      { color: palette.night, opacity: 0.7, weight: 2 },
      { color: palette.chrome, opacity: 0.92, weight: 3 },
      { color: palette.blossom, opacity: 0.7, weight: 1 },
    ],
  },
  {
    base: '#E8D9AE',
    strokes: [
      { color: palette.ochre, opacity: 0.88, weight: 3 },
      { color: palette.chrome, opacity: 0.92, weight: 3 },
      { color: palette.cypress, opacity: 0.75, weight: 2 },
      { color: palette.sky, opacity: 0.6, weight: 1 },
    ],
  },
];

const cards = repos.map((r, i) => {
  const seed = [...r.repo].reduce((n, c) => (n * 31 + c.charCodeAt(0)) >>> 0, 7);
  const rand = rng(seed);
  return {
    ...r,
    seed,
    mood: moods[i % moods.length],
    tilt: Math.round((rand() - 0.5) * 34) / 10,
    ratio: ['4 / 3', '1 / 1', '5 / 4'][Math.floor(rand() * 3)],
    angle: rand() * 6.28,
    swirl: 1.4 + rand() * 2,
    stats: (r.private
      ? [r.language, 'private repo']
      : [r.language, `★ ${r.stars}`, `pushed ${ago(r.pushedAt, fetchedAt)}`]
    )
      .filter(Boolean)
      .join(' · '),
  };
});
---

<Surface name="wall" seed={67} id="projects">
  <div class="wrap">
    <h2>Projects</h2>
    <p>
      Things I build after hours. The details come from{' '}
      <a href={`https://github.com/${site.github}`}>GitHub</a> each time the site is built, so the dates stay
      honest.
    </p>
    <ul class="gallery">
      {cards.map((c) => (
        <li>
          <Frame tilt={c.tilt} ratio={c.ratio}>
            <BrushField
              seed={c.seed % 9973}
              fit
              base={c.mood.base}
              width={360}
              height={300}
              strokes={c.mood.strokes}
              cell={17}
              length={[24, 58]}
              thickness={[7, 15]}
              angle={c.angle}
              swirl={c.swirl}
            />
            <Fragment slot="plate">
              {c.url ? (
                <a class="plate-title" href={c.url}>
                  {c.title}
                </a>
              ) : (
                <strong class="plate-title">{c.title}</strong>
              )}
              <span class="plate-blurb">{c.blurb}</span>
              <span class="mono plate-stats">{c.stats}</span>
              {c.live && (
                <a class="mono plate-stats" href={c.live}>
                  {new URL(c.live).host}
                </a>
              )}
            </Fragment>
          </Frame>
        </li>
      ))}
    </ul>

    <div class="year">
      <ContributionSky days={days} />
      <div class="year__note">
        <VermilionStroke seed={21} width="4.5rem" />
        <MarginNote rotate={-2} arrow="up-left">
          one star per day. brighter star, busier day.
        </MarginNote>
      </div>
    </div>
    <Signature seed={19} />
  </div>
  <BrushDivider slot="divider" to="terrace" seed={71} />
</Surface>

<style>
  /* A centred wall: a short last row sits in the middle, not alone at the left. */
  .gallery {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 3.2rem clamp(1.5rem, 4vw, 4rem);
    margin: 2.5rem 0 0;
    padding: 0 clamp(0.4rem, 2vw, 1.5rem);
    list-style: none;
  }
  .gallery > li {
    flex: 0 1 17rem;
    min-width: min(100%, 14rem);
  }
  @media (min-width: 36rem) {
    .gallery > :nth-child(even) {
      margin-top: clamp(0rem, 4vw, 3rem);
    }
  }
  .year {
    margin-top: clamp(4rem, 9vw, 7rem);
  }
  .year__note {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1rem 2rem;
    margin-top: 1.6rem;
    padding-left: clamp(0.5rem, 6vw, 5rem);
  }
</style>
