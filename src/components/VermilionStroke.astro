---
// The vermilion thread: one red brush stroke per section, and no more.
import { brushStroke } from '../lib/brush';

interface Props {
  seed?: number;
  /** CSS width. */
  width?: string;
}
const { seed = 1, width = '11rem' } = Astro.props;
---

<svg
  class="vermilion-stroke"
  viewBox="0 0 300 24"
  preserveAspectRatio="none"
  style={`width:${width}`}
  aria-hidden="true"
  focusable="false"
>
  <path d={brushStroke(seed)}></path>
</svg>

<style>
  .vermilion-stroke {
    display: block;
    height: 0.85rem;
    overflow: visible;
  }
  .vermilion-stroke path {
    fill: var(--vermilion);
    filter: url(#impasto);
  }
</style>
