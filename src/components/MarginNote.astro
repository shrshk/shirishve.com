---
// A handwritten aside. Dry, precise, never an exclamation mark.
interface Props {
  /** Degrees of tilt. */
  rotate?: number;
  /** Draw a hand-made arrow from the note toward what it is about. */
  arrow?: 'left' | 'right' | 'up-left' | 'none';
}
const { rotate = -2, arrow = 'none' } = Astro.props;
---

<p class:list={['margin-note', `margin-note--${arrow}`]} style={`--rot:${rotate}deg`}>
  {arrow !== 'none' && (
    <svg class="margin-note__arrow" viewBox="0 0 70 40" width="70" height="40" aria-hidden="true">
      <path d="M66 8C50 2 22 6 6 30" />
      <path d="M4 16.5L5.6 30.6 19 26" />
    </svg>
  )}
  <span>
    <slot />
  </span>
</p>

<style>
  .margin-note {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.4rem;
    max-width: 22ch;
    margin: 0;
    font-family: var(--font-hand);
    font-size: clamp(1.4rem, 1.25rem + 0.7vw, 1.8rem);
    font-weight: 400;
    line-height: 1.08;
    color: var(--text);
    rotate: var(--rot);
  }
  .margin-note__arrow {
    flex: none;
    margin-top: 0.5rem;
  }
  .margin-note__arrow path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .margin-note--right {
    flex-direction: row-reverse;
  }
  .margin-note--right .margin-note__arrow {
    scale: -1 1;
  }
  .margin-note--up-left .margin-note__arrow {
    scale: 1 -1;
    margin-top: -0.6rem;
  }
</style>
