---
// Section 5: a café terrace in the evening. What I love away from work.
// The club is never named: red and white, and a scarf on a chair. No crest, wordmark or kit.
// Computer science and maths sit on the table: a chalk slate and a napkin sketch.
import BrushDivider from './BrushDivider.astro';
import MarginNote from './MarginNote.astro';
import Signature from './Signature.astro';
import Surface from './Surface.astro';
import { show, soccer } from '../lib/content';
import { palette } from '../lib/palette';

const STRIPE = 60;
const stripes = Array.from({ length: 1200 / STRIPE }, (_, i) => ({
  d: `M${i * STRIPE} 0H${(i + 1) * STRIPE}V58q-${STRIPE / 2} 30 -${STRIPE} 0Z`,
  red: i % 2 === 0,
}));
---

<Surface name="terrace" seed={89} id="terrace">
  <svg class="awning" viewBox="0 0 1200 90" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    {stripes.map((s) => (
      <path d={s.d} fill={s.red ? palette.vermilion : '#F7EFD9'} />
    ))}
    <path d="M0 4H1200" stroke="#8A5A10" stroke-width="8"></path>
  </svg>

  <div class="wrap terrace">
    <div class="terrace__words">
      <h2>{soccer.title}</h2>
      <p class="lede">{soccer.line}.</p>
      <p>{show(soccer.body)}</p>
      <p>
        <strong>Guess the Pass.</strong> {show(soccer.guessThePass.line)}
      </p>
      {soccer.guessThePass.url && (
        <p>
          <a class="btn paint" href={soccer.guessThePass.url}>
            Play Guess the Pass
          </a>
        </p>
      )}
      <div class="terrace__note">
        <MarginNote rotate={-2} arrow="right">
          {soccer.note}
        </MarginNote>
      </div>
    </div>

    <svg
      class="chair"
      viewBox="0 0 150 190"
      role="img"
      aria-label="A café chair with a red and white scarf over its back"
    >
      <g class="chair__wood">
        <path d="M38 96C34 50 44 22 75 20s42 28 37 76"></path>
        <path d="M52 94C50 62 56 40 75 39s25 22 23 55"></path>
        <ellipse cx="75" cy="104" rx="46" ry="13"></ellipse>
        <path d="M36 110 26 182M114 110 124 182M58 116 54 176M92 116 96 176M34 150 118 150"></path>
      </g>
      <g class="chair__scarf">
        <path class="red" d="M40 44C58 30 96 30 112 46L108 62C94 48 60 48 46 60Z"></path>
        <path class="red" d="M104 50 126 58 118 122 98 118Z"></path>
        <path
          class="white"
          d="M58 37 66 35 70 50 62 53ZM84 35 92 37 90 52 82 50ZM108 76 123 79 121 94 105 91Z"
        ></path>
        <path class="fringe" d="M99 119 97 132M104 120 103 134M109 121 109 135M114 122 115 135"></path>
      </g>
    </svg>

    <ul class="table">
      <li class="slate">
        <svg
          viewBox="0 0 300 190"
          role="img"
          aria-label="A café chalkboard. Today: Euler's identity. Espresso costs O(1), a refill O(log n). A chalk spiral in the corner."
        >
          <rect class="slate__wood" x="3" y="3" width="294" height="184"></rect>
          <rect class="slate__board" x="13" y="13" width="274" height="164"></rect>
          <g class="chalk">
            <text x="30" y="46" class="chalk__head">
              today
            </text>
            <path class="chalk__line" d="M29 54C52 51 76 56 98 52"></path>
            <text x="30" y="92" class="chalk__maths">
              e
              <tspan dy="-11" font-size="17">
                iπ
              </tspan>
              <tspan dy="11"> + 1 = 0</tspan>
            </text>
            <text x="30" y="126">
              espresso
            </text>
            <text x="186" y="126" text-anchor="end">
              O(1)
            </text>
            <text x="30" y="156">
              refill
            </text>
            <text x="186" y="156" text-anchor="end">
              O(log n)
            </text>
            <path class="chalk__dots" d="M104 121H140M76 151H112"></path>
            <path
              class="chalk__line"
              d="M232 96a4 4 0 0 1 4 -4a4 4 0 0 1 4 4a8 8 0 0 1 -8 8a12 12 0 0 1 -12 -12a20 20 0 0 1 20 -20a32 32 0 0 1 32 32"
            ></path>
          </g>
        </svg>
      </li>
      <li class="napkin paint">
        <svg
          viewBox="0 0 300 190"
          role="img"
          aria-label="A sketch on a napkin: three passes between three players form a right triangle. Under it, a squared plus b squared equals c squared."
        >
          <g class="ink">
            <path d="M70 128H196M206 122V52M196 40 78 120"></path>
            <path d="M188 122 198 128 188 134M200 62 206 50 212 62M90 106 76 122 96 118"></path>
            <path class="ink__corner" d="M192 128V114H206"></path>
            <path class="ink__run" d="M206 38C222 22 244 22 258 36"></path>
          </g>
          <g class="ink__players">
            <circle cx="62" cy="128" r="7"></circle>
            <circle cx="206" cy="128" r="7"></circle>
            <circle cx="206" cy="40" r="7"></circle>
          </g>
          <g class="ink__words">
            <text x="128" y="148">
              a
            </text>
            <text x="218" y="92">
              b
            </text>
            <text x="120" y="74">
              c
            </text>
            <text x="34" y="178" class="ink__maths">
              a
              <tspan dy="-9" font-size="15">
                2
              </tspan>
              <tspan dy="9"> + b</tspan>
              <tspan dy="-9" font-size="15">
                2
              </tspan>
              <tspan dy="9"> = c</tspan>
              <tspan dy="-9" font-size="15">
                2
              </tspan>
            </text>
          </g>
        </svg>
      </li>
    </ul>
    <Signature seed={27} />
  </div>
  <BrushDivider slot="divider" to="night" seed={83} />
</Surface>

<style>
  .awning {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: clamp(44px, 7vw, 86px);
    filter: url(#rough);
  }
  .terrace {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: 2.5rem clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-top: clamp(1.5rem, 5vw, 4rem);
  }
  .terrace__note {
    margin-top: 1.5rem;
  }
  .chair {
    width: min(100%, 13rem);
    justify-self: center;
    overflow: visible;
  }
  .chair path,
  .chair ellipse {
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .chair__wood path,
  .chair__wood ellipse {
    fill: none;
    stroke: var(--ochre);
    stroke-width: 5;
  }
  .chair__wood ellipse {
    fill: #8a5a10;
  }
  .chair__scarf {
    filter: url(#rough-fine);
  }
  .chair__scarf .red {
    fill: var(--vermilion);
  }
  .chair__scarf .white {
    fill: #f7efd9;
  }
  .chair__scarf .fringe {
    fill: none;
    stroke: var(--vermilion);
    stroke-width: 3;
  }

  .table {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 2.2rem clamp(1.5rem, 4vw, 3.5rem);
    padding: 0;
    margin: 1rem 0 0;
    list-style: none;
  }
  .table li {
    flex: 1 1 15rem;
    max-width: 21rem;
  }
  .table svg {
    display: block;
    width: 100%;
    overflow: visible;
  }
  .table text {
    font-family: var(--font-hand);
    font-size: 24px;
  }

  .slate {
    rotate: -1.6deg;
  }
  .slate__wood {
    fill: var(--gilt-dark);
    filter: url(#rough);
  }
  .slate__board {
    fill: var(--night);
    filter: url(#rough-fine);
  }
  .chalk text {
    fill: #f7efd9;
  }
  .chalk .chalk__head {
    font-size: 28px;
    font-weight: 700;
  }
  .chalk .chalk__maths {
    font-size: 30px;
  }
  .chalk path {
    fill: none;
    stroke: #f7efd9;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .chalk .chalk__dots {
    stroke-dasharray: 1 7;
    opacity: 0.7;
  }

  .napkin {
    --paint: #f7efd9;
    padding: 0.6rem;
    color: var(--night);
    rotate: 1.3deg;
    margin-top: 1.2rem;
  }
  .ink path {
    fill: none;
    stroke: var(--night);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ink .ink__corner {
    stroke-width: 1.4;
  }
  .ink .ink__run {
    stroke-dasharray: 5 6;
  }
  .ink__players circle {
    fill: var(--vermilion);
    filter: url(#rough-fine);
  }
  .ink__words text {
    fill: var(--night);
  }
  .ink__words .ink__maths {
    font-size: 26px;
  }
  @media (max-width: 46rem) {
    .terrace {
      grid-template-columns: 1fr;
    }
    .chair {
      width: 9rem;
    }
  }
</style>
