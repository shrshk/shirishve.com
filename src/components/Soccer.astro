---
// Section 5: a café terrace on matchday evening.
// The club is shown through red and white, original drawing and words. No crest, wordmark or kit.
import BrushDivider from './BrushDivider.astro';
import BrushField from './BrushField.astro';
import MarginNote from './MarginNote.astro';
import Signature from './Signature.astro';
import Surface from './Surface.astro';
import { show, soccer } from '../lib/content';
import { palette } from '../lib/palette';

const STRIPE = 60;
const stripes = Array.from({ length: 1200 / STRIPE }, (_, i) => ({
  d: `M${i * STRIPE} 0H${(i + 1) * STRIPE}V58q-${STRIPE / 2} 30 -${STRIPE} 0Z`,
  red: i % 2 === 0,
}));

const pitches = [
  [
    { color: '#2E6B3E', opacity: 0.9, weight: 4 },
    { color: '#3F8650', opacity: 0.85, weight: 3 },
    { color: palette.cypress, opacity: 0.8, weight: 2 },
    { color: palette.chrome, opacity: 0.5, weight: 1 },
  ],
  [
    { color: palette.cobalt, opacity: 0.85, weight: 3 },
    { color: palette.night, opacity: 0.8, weight: 3 },
    { color: '#3F8650', opacity: 0.85, weight: 3 },
    { color: palette.chrome, opacity: 0.7, weight: 1 },
  ],
];
---

<Surface name="terrace" seed={89} id="soccer">
  <svg class="awning" viewBox="0 0 1200 90" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    {stripes.map((s) => (
      <path d={s.d} fill={s.red ? palette.vermilion : '#F7EFD9'} />
    ))}
    <path d="M0 4H1200" stroke="#8A5A10" stroke-width="8"></path>
  </svg>

  <div class="wrap terrace">
    <div class="terrace__words">
      <h2>Matchday</h2>
      <p class="lede">
        {soccer.club}. {soccer.line}.
      </p>
      <p>
        <strong>Guess the Pass.</strong> {show(soccer.guessThePass.line)}
      </p>
      {soccer.guessThePass.url && (
        <p>
          <a class="btn paint" href={soccer.guessThePass.url}>
            Play Guess the Pass
          </a>
        </p>
      )}
      <div class="terrace__note">
        <MarginNote rotate={-2} arrow="right">
          the scarf stays on the chair until full time.
        </MarginNote>
      </div>
    </div>

    <svg
      class="chair"
      viewBox="0 0 150 190"
      role="img"
      aria-label="A café chair with a red and white scarf over its back"
    >
      <g class="chair__wood">
        <path d="M38 96C34 50 44 22 75 20s42 28 37 76"></path>
        <path d="M52 94C50 62 56 40 75 39s25 22 23 55"></path>
        <ellipse cx="75" cy="104" rx="46" ry="13"></ellipse>
        <path d="M36 110 26 182M114 110 124 182M58 116 54 176M92 116 96 176M34 150 118 150"></path>
      </g>
      <g class="chair__scarf">
        <path class="red" d="M40 44C58 30 96 30 112 46L108 62C94 48 60 48 46 60Z"></path>
        <path class="red" d="M104 50 126 58 118 122 98 118Z"></path>
        <path
          class="white"
          d="M58 37 66 35 70 50 62 53ZM84 35 92 37 90 52 82 50ZM108 76 123 79 121 94 105 91Z"
        ></path>
        <path class="fringe" d="M99 119 97 132M104 120 103 134M109 121 109 135M114 122 115 135"></path>
      </g>
    </svg>

    <ul class="postcards">
      {soccer.postcards.map((p, i) => (
        <li class="postcard paint">
          <div class="postcard__picture" role="img" aria-label={`A painted postcard: ${p.title}`}>
            {p.photo ? (
              <img src={p.photo} alt="" loading="lazy" />
            ) : (
              <BrushField
                seed={70 + i}
                fit
                base={i ? palette.night : '#2E6B3E'}
                width={300}
                height={190}
                strokes={pitches[i % 2]}
                cell={17}
                length={[24, 54]}
                thickness={[7, 13]}
                angle={i ? 0.3 : 0}
                swirl={i ? 1.6 : 0.35}
              />
            )}
          </div>
          <div class="postcard__back">
            <strong>{p.title}</strong>
            <span>{show(p.caption)}</span>
          </div>
          <span class="postcard__stamp" aria-hidden="true" />
        </li>
      ))}
    </ul>
    <Signature seed={27} />
  </div>
  <BrushDivider slot="divider" to="night" seed={83} />
</Surface>

<style>
  .awning {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: clamp(44px, 7vw, 86px);
    filter: url(#rough);
  }
  .terrace {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: 2.5rem clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-top: clamp(1.5rem, 5vw, 4rem);
  }
  .terrace__note {
    margin-top: 1.5rem;
  }
  .chair {
    width: min(100%, 13rem);
    justify-self: center;
    overflow: visible;
  }
  .chair path,
  .chair ellipse {
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .chair__wood path,
  .chair__wood ellipse {
    fill: none;
    stroke: var(--ochre);
    stroke-width: 5;
  }
  .chair__wood ellipse {
    fill: #8a5a10;
  }
  .chair__scarf {
    filter: url(#rough-fine);
  }
  .chair__scarf .red {
    fill: var(--vermilion);
  }
  .chair__scarf .white {
    fill: #f7efd9;
  }
  .chair__scarf .fringe {
    fill: none;
    stroke: var(--vermilion);
    stroke-width: 3;
  }

  .postcards {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 2.2rem clamp(1.5rem, 4vw, 3.5rem);
    padding: 0;
    margin: 1rem 0 0;
    list-style: none;
  }
  .postcard {
    --paint: #f7efd9;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 1rem;
    flex: 1 1 19rem;
    max-width: 30rem;
    padding: 0.9rem;
    color: var(--night);
    rotate: -1.6deg;
  }
  .postcard:nth-child(even) {
    rotate: 1.3deg;
    margin-top: 1.2rem;
  }
  .postcard__picture {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }
  .postcard__picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .postcard__back {
    display: grid;
    align-content: end;
    gap: 0.3rem;
    padding-top: 3.2rem;
    font-family: var(--font-hand);
    font-size: 1.3rem;
    line-height: 1.1;
  }
  .postcard__back strong {
    font-family: var(--font-display);
    font-variation-settings:
      'SOFT' 100,
      'WONK' 1;
    font-size: 1.05rem;
  }
  .postcard__stamp {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    width: 2.1rem;
    height: 2.6rem;
    background: var(--vermilion);
    outline: 2px dashed #f7efd9;
    outline-offset: -5px;
  }
  @media (max-width: 46rem) {
    .terrace {
      grid-template-columns: 1fr;
    }
    .chair {
      width: 9rem;
    }
  }
</style>
