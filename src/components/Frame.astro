---
// A gilt frame hung on the wall by a wire, slightly crooked.
// Default slot is the canvas; the "plate" slot is the caption under it.
interface Props {
  /** Degrees. Keep it small: -2 to 2. */
  tilt?: number;
  /** CSS aspect-ratio of the canvas. */
  ratio?: string;
  /** Text alternative for the painted canvas, when it is a picture. */
  alt?: string;
}
const { tilt = 0, ratio = '4 / 3', alt } = Astro.props;
---

<figure class="frame" style={`--tilt:${tilt}deg; --ratio:${ratio}`}>
  <svg class="frame__wire" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
    <path d="M16 40 L50 5 L84 40"></path>
  </svg>
  <span class="frame__nail" aria-hidden="true"></span>
  <div class="frame__body">
    <div class="frame__gilt paint paint--impasto">
      <div class="frame__canvas" role={alt ? 'img' : undefined} aria-label={alt}>
        <slot />
      </div>
    </div>
  </div>
  {Astro.slots.has('plate') && (
    <figcaption class="frame__plate paint">
      <slot name="plate" />
    </figcaption>
  )}
</figure>

<style>
  .frame {
    position: relative;
    margin: 0;
    padding-top: 2.6rem;
    rotate: var(--tilt);
    transform-origin: 50% 0.4rem;
  }
  .frame__wire {
    position: absolute;
    top: 0.4rem;
    left: 0;
    width: 100%;
    height: 2.4rem;
    overflow: visible;
  }
  .frame__wire path {
    fill: none;
    stroke: var(--night);
    stroke-opacity: 0.6;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .frame__nail {
    position: absolute;
    top: 0.25rem;
    left: 50%;
    width: 0.6rem;
    height: 0.6rem;
    translate: -50% 0;
    border-radius: 50%;
    background: var(--night);
  }

  /* A flat, hard-edged patch of darker wall behind the frame: painted shade, not a blur. */
  .frame__body {
    position: relative;
  }
  .frame__body::before {
    content: '';
    position: absolute;
    inset: 10px -9px -12px 8px;
    background: var(--night);
    opacity: 0.28;
    filter: url(#rough);
  }

  /* Gilt moulding: layered solid bands, carved with fine diagonal cuts. */
  .frame__gilt {
    padding: clamp(14px, 2.4vw, 22px);
    --paint:
      repeating-linear-gradient(
        48deg,
        transparent 0 5px,
        color-mix(in srgb, var(--gilt-dark) 38%, transparent) 5px 7px
      ),
      linear-gradient(
        135deg,
        var(--gilt-light) 0%,
        var(--ochre) 28%,
        var(--gilt-dark) 50%,
        var(--chrome) 72%,
        var(--gilt-light) 100%
      );
  }
  .frame__gilt::before {
    box-shadow:
      inset 0 0 0 3px var(--gilt-dark),
      inset 0 0 0 6px var(--gilt-light),
      inset 0 0 0 8px var(--ochre);
  }
  .frame__canvas {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--canvas);
    color: var(--night);
    outline: 4px solid var(--gilt-shade);
    box-shadow: 0 0 0 7px var(--gilt-dark);
  }

  /* Brass plate under the frame. */
  .frame__plate {
    width: fit-content;
    max-width: 92%;
    margin: 1.5rem auto 0;
    padding: 0.5rem 1.1rem 0.6rem;
    text-align: center;
    color: var(--night);
    --paint: #e7d9a9;
    rotate: calc(var(--tilt) * -0.5);
  }
  .frame__plate::before {
    box-shadow: inset 0 0 0 2px var(--ochre);
  }
</style>
